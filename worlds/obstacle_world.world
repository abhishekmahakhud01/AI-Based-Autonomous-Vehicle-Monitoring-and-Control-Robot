<?xml version="1.0"?>
<sdf version="1.6">
  <world name="obstacle_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gui><camera name="user_camera"><pose>-3 -4 3 0 0.5 0.9</pose></camera></gui>

    <!-- Box straight ahead of the robot (robot starts at 0,0 facing +X) -->
    <model name="box_front"><static>true</static><pose>1.2 0 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.3 0.8 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 0.8 0.5</size></box></geometry>
      <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>

    <model name="box_left"><static>true</static><pose>0.8 1.3 0.25 0 0 0.4</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
      <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual></link></model>

    <model name="cylinder_right"><static>true</static><pose>0.6 -1.4 0.3 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
      <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material></visual></link></model>

    <!-- Four boundary walls (about 6 m x 6 m arena) -->
    <model name="wall_north"><static>true</static><pose>0 3 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -3 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>3 0 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 6 0.5</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-3 0 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 6 0.5</size></box></geometry></visual></link></model>
  </world>
</sdf>
